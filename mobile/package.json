    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.16",
    "expo-notifications": "~57.0.19",
    "expo-print": "~57.0.1",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-speech": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
