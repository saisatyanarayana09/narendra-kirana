    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.4",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^8.57.1",
    "eslint-config-universe": "^16.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --clear",
    "lan": "expo start --lan --clear",
    "tunnel": "expo start --tunnel --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "ota": "eas update --branch production",
    "ota:preview": "eas update --branch preview",
    "postinstall": "mkdir -p node_modules/react-native/src && echo 'module.exports = {};' > node_modules/react-native/src/setup-env.js || true",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --quiet",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest src/utils src/context src/api",
    "test:components": "jest src/components src/screens",
    "test:e2e": "maestro test .maestro/",
    "test:visual": "echo 'Visual regression not yet implemented' && exit 0",
    "test:a11y": "echo 'Accessibility tests running via Jest a11y matchers' && exit 0",
    "test:all": "npm run test:unit && npm run test:components && npm run test:e2e",
    "validate": "npm run lint && npm run typecheck && npm run test"
  },
  "private": true
}
